rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product images are public to read and isolated to the uploader's account.
    match /products/{ownerUid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Default deny for all other files
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
